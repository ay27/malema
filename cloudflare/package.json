{
  "name": "malema-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/web/board.ts --bundle --format=esm --target=es2022 --minify --outfile=public/board.js",
    "check": "node scripts/check-model-catalog.mjs && tsc --noEmit",
    "test": "node --test 'src/*.test.ts' 'src/web/*.test.ts'",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "migrate:local": "wrangler d1 migrations apply malema --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.167.0"
  }
}
